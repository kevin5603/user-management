!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{:charset => "UTF-8"}/
    %title New User Registration
    :css
      body {
          font-family: Arial, sans-serif;
          line-height: 1.6;
          color: #333333;
          max-width: 600px;
          margin: 0 auto;
          padding: 20px;
      }
      .header {
          border-bottom: 2px solid #4285f4;
          padding-bottom: 10px;
          margin-bottom: 20px;
      }
      .section-title {
          background-color: #f2f2f2;
          padding: 8px;
          font-weight: bold;
          margin-bottom: 10px;
      }
      .info-table {
          width: 100%;
          border-collapse: collapse;
          margin-bottom: 20px;
      }
      .info-table td {
          padding: 8px;
          border-bottom: 1px solid #ddd;
      }
      .info-table td:first-child {
          font-weight: bold;
          width: 40%;
      }
      .action-items {
          background-color: #f9f9f9;
          padding: 15px;
          margin-bottom: 20px;
          border-left: 4px solid #4285f4;
      }
      .checkbox {
          margin-right: 10px;
      }
      .footer {
          font-size: 12px;
          color: #777;
          margin-top: 30px;
          padding-top: 10px;
          border-top: 1px solid #ddd;
      }
  %body
    .header
      %h2
        New User Registration: #{@user.first_name + " " + @user.last_name}
    %p Hello Admin,
    %p A new user has registered on the platform.
    .section-title User Details
    %table.info-table
      %tr
        %td Email:
        %td= @user.email
      %tr
        %td Registration Date:
        %td= @user.created_at
      %tr
        %td Job Title:
        %td= @user.job_title
    .section-title Action Required
    .action-items
      %p
        %span.checkbox ☐
        Verify user information
      %p
        %span.checkbox ☐
        Assign user permissions
      %p
        %span.checkbox ☐
        Approve account (if manual approval is required)
    %p For any questions or concerns, please contact the IT support team.
    %p
      Thank you,
      %br/
      Notification System
    .footer
      This is an automated message. Please do not reply directly to this email.
