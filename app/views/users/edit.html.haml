%h2
  Edit #{resource_name.to_s.humanize}
= form_for(@user, url: user_path(@user.id), html: { method: :put }) do |f|
  = render "devise/shared/error_messages", resource: @user
  = render "shared/form", f: f
  .field
    %label Roles
    %br/
    - @roles.each do |role|
      = check_box_tag "user[role_ids][]", value=role.id, @user.roles.map(&:name).include?(role.name)
      = role.name
      %br/
  .actions
    = f.submit "Update"
= link_to "Back", users_path
