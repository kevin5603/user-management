%h2
  Edit #{@user.class.name.humanize}
= form_for(@user, url: user_path(@user.id), html: { method: :put }) do |f|
  = render "shared/error_messages", resource: @user
  = render "shared/form", f: f
  .field
    %label Roles
    %br/
    - @roles.each do |role|
      = check_box_tag "user[role_ids][]", value=role.id, @user.roles.pluck(:id).include?(role.id)
      = role.name
      %br/
  .actions
    = f.submit "Update"
= link_to "Back", users_path
