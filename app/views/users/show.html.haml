%p#notice= notice

%p
  %b First name:
  = @user.first_name
%p
  %b Last name:
  = @user.last_name
%p
  %b Email:
  = @user.email
%p
  %b Job title:
  = @user.job_title
%p
  %b Phone number:
  = @user.phone_number

%p
  %b Role name:
  = @user.roles.each do |role|
    = role.name

= link_to 'Edit', edit_user_path(@user)
\|
= link_to 'Back', users_path
