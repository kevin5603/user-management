<h1>Users#show</h1>
<div>
  <%= link_to "edit this user", edit_user_path(@user)  %>
</div>
<br>

<div>
  <p>
    <%= @user.inspect %>
  </p>
  <p>
    <% if @user.roles.any?  %>
      <% @user.roles.each do |role| %>
        <%= role.name %>,
      <% end %>
    <% else %>
      No Roles
    <% end %>
  </p>
</div>