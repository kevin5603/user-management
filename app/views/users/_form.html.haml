= form_for @user do |f|
  - if @user.errors.any?
    #error_explanation
      %h2= "#{pluralize(@user.errors.count, "error")} prohibited this user from being saved:"
      %ul
        - @user.errors.full_messages.each do |message|
          %li= message

  .field
    = f.label :first_name
    = f.text_field :first_name
  .field
    = f.label :last_name
    = f.text_field :last_name
  .field
    = f.label :email
    = f.text_field :email
  .field
    = f.label :job_title
    = f.text_field :job_title
  .field
    = f.label :phone_number
    = f.text_field :phone_number
  .field
    = f.label :roles
    = f.collection_select(:role_ids, Role.all, :id, :name, { prompt: true} )
  .actions
    = f.submit 'Save'
