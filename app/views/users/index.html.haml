%h1 User Management

- if user_signed_in?
  %p
    Logged in as #{current_user.email} (Role: #{current_user.roles.pluck(:name).join(", ")})
    = link_to "Logout", destroy_user_session_path, method: :delete

- if can?(:read, User) # Only Admins and Managers should see the user list
  %table.table
    %thead
      %tr
        %th Name
        %th Email
        %th Job Title
        %th Phone Number
        %th Roles
        %th Actions

    %tbody
      - @users.each do |user|
        %tr
          %td= user.full_name
          %td= user.email
          %td= user.job_title
          %td= user.phone_number
          %td= user.roles.pluck(:name).join(", ") # Display user roles

          %td
            = link_to 'Show', user if can?(:read, user) # Everyone can see "Show"

            - if can?(:update, user) # Only Admins can edit
              | |
              = link_to 'Edit', edit_user_path(user)

            - if can?(:destroy, user) # Only Admins can delete
              | |
              = link_to 'Delete', user, method: :delete, data: { confirm: 'Are you sure?' }

  %br

  - if can?(:create, User) # Only Admins can create new users
    = link_to 'New User', new_user_path

- elsif current_user.roles.exists?(name: 'user') # Regular users only see their profile
  %p
    = link_to 'View Your Profile', user_path(current_user)
