%h1 User Management

- if user_signed_in?
  %p
    Logged in as #{current_user.email}
    = link_to "Logout", destroy_user_session_path, method: :delete

%table.table
  %thead
    %tr
      %th Name
      %th Email
      %th Job Title
      %th Phone Number
      %th Actions

  %tbody
    - @users.each do |user|
      %tr
        %td= user.full_name
        %td= user.email
        %td= user.job_title
        %td= user.phone_number
        %td
          = link_to 'Show', user

          - if can?(:update, user)
            | |
            = link_to 'Edit', edit_user_path(user)

          - if can?(:destroy, user)
            | |
            = link_to 'Delete', user, method: :delete, data: { confirm: 'Are you sure?' }

%br

- if can?(:create, User)
  = link_to 'New User', new_user_path
