%h1 Listing users

%table
  %thead
    %tr
      %th First name
      %th Last name
      %th Email
      %th Job title
      %th Phone number
      %th Roles
      %th
      %th
      %th

  %tbody
    - @users.each do |user|
      %tr
        %td= user.first_name
        %td= user.last_name
        %td= user.email
        %td= user.job_title
        %td= user.phone_number
        %td
          - user.roles.each do |role|
            = role.name
        %td= link_to 'Show', user
        %td
          - if can? :update, user
            = link_to 'Edit', edit_user_path(user)
        %td
          - if can? :delete, user
            = button_to 'Destroy', user, method: :delete, data: { confirm: 'Are you sure?' }

%br
- if can? :create, current_user
  = link_to 'New User', new_user_path
