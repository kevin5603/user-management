%h1 User Management

%h1 Users

%table.table
  %thead
    %tr
      %th Name
      %th Email
      %th Job Title
      %th Phone Number
      %th Actions

  %tbody
    - @users.each do |user|
      %tr
        %td= user.full_name
        %td= user.email
        %td= user.job_title
        %td= user.phone_number
        %td
          = link_to 'Show', user
          |
          = link_to 'Edit', edit_user_path(user)
          |
          = link_to 'Delete', user, method: :delete, data: { confirm: 'Are you sure?' }

%br

= link_to 'New User', new_user_path
