.container
  %br/
  %h1.text-center Users Management
  %hr/
  %table.table
    %thead
      %tr
        %th{:scope => "col"} #
        %th{:scope => "col"} First
        %th{:scope => "col"} Last
        %th{:scope => "col"} Email
        %th{:scope => "col"} Phone
        %th{:scope => "col"} Job Title
        %th{:scope => "col"} Role
        %th{:scope => "col"} Status
        - if can?(:update, User) || can?(:destroy, User)
          %th{:scope => "col"} action
    %tbody
      - @users.each_with_index do |user, index|
        %tr
          %th{:scope => "row"}= index + 1
          %td= user.first_name
          %td= user.last_name
          %td= user.email
          %td= user.phone_number
          %td= user.job_title
          %td= user.roles.map(&:name).join(", ")
          %td= user.confirmed_at ? "Enabled" : "Disabled"
          - if can? :update, user
            %td= button_to "Update Profile", edit_user_path(user.id), method: :get, class: "btn btn-primary"
          - if can? :destroy, User
            %td= button_to "Delete User", user_path(user.id), method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure you want to delete this user?" }
