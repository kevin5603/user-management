<div class="container">
  <h1>Users Management</h1>
  <hr>
  <table class="table">
    <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">First</th>
      <th scope="col">Last</th>
      <th scope="col">Email</th>
      <th scope="col">Phone</th>
      <th scope="col">Job Title</th>
      <th scope="col">Role</th>
      <th scope="col">action</th>
    </tr>
    </thead>
    <tbody>
      <% @users.each_with_index do |user, index| %>
        <tr>
          <th scope="row"><%= index + 1 %></th>
          <td><%= user.first_name %></td>
          <td><%= user.last_name %></td>
          <td><%= user.email %></td>
          <td><%= user.phone_number %></td>
          <td><%= user.job_title %></td>
          <td><%= user.roles.map(&:name).join("\n") %></td>
          <td><%= button_to "Update Profile", edit_user_path(user.id), method: :get, class: "btn btn-primary" %></td>
          <td><%= button_to "Delete Profile", user_path(user.id), method: :delete, class: "btn btn-danger" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
