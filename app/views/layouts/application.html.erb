<!DOCTYPE html>
<html>
  <head>
    <title>UserManagement</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <ul class="nav justify-content-end navbar-light bg-light">

      <% if user_signed_in? %>
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link"><%= current_user.email %></a>
        <a class="nav-link" href="/users/edit">Profile</a>
        <a class="nav-link" href="/users/sign_out" data-method="delete" >Sign Out</a>
      <% else %>
        <li class="nav-item">
          <a class="nav-link" href="/users/sign_in">Sign In</a>
        </li>
      <% end %>
    </ul>
    <% if notice %>
      <div class="alert alert-success notice" role="alert">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger alert" role="alert">
        <%= alert %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
