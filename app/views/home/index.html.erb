<% @user = current_user %>
<h1>Home</h1>

<h3>Feature</h3>

<p>
  <% if can? :index, @user %>
    <%= link_to "view all users", users_path %>
  <% else %>
    Cannnot view all users
  <% end %>
</p>

<h3>info</h3>

<p>
  <%= @user.inspect %>
</p>

<h3>Permissions</h3>

<p>
  <% if @user.roles.any?  %>
    <% @user.roles.each do |role| %>
      <%= role.name %>,
    <% end %>
  <% else %>
    No Roles
  <% end %>
</p>

<% permissions = @user.roles.flat_map(&:permissions).uniq %>

<% if permissions.any? %>
  <ul>
    <% permissions.each do |permission| %>
      <li><%= permission.name %></li>
    <% end %>
  </ul>
<% else %>
  <p>No permissions found for this user.</p>
<% end %>